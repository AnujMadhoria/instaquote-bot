# Copy to .env for local testing (never commit the real .env file)

# Optional — enables AI-generated quotes/captions. Without it, the
# pipeline uses free template-based fallbacks automatically.
GEMINI_API_KEY=

# Your Instagram handle, shown as the small watermark on the image
IG_HANDLE=your.handle

# Required only for publish.py (posting to Instagram)
GH_REPO=yourname/instaquote-bot
GH_BRANCH=main
IG_USER_ID=
IG_ACCESS_TOKEN=
